# ansible/roles/app/templates/app.env.j2
# Environment variables for the application
APP_ENV={{ environment }}
APP_VERSION=1.0.0
PORT={{ app_port }}
PROJECT={{ project | default('iac-demo') }}

# Database — injected from Terraform outputs
DB_HOST={{ db_host | default('') }}
DB_PORT=5432
DB_NAME={{ db_name | default('appdb') }}
DB_USER={{ db_username | default('dbadmin') }}
DB_PASSWORD={{ db_password | default('') }}

# AWS
AWS_DEFAULT_REGION={{ aws_region | default('ap-south-1') }}
